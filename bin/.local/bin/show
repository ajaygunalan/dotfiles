#!/usr/bin/env bash
# show FILE START:END [HL:HL ...]   print a line range with highlighted lines, real line numbers
# show FILE                          print the whole file
set -euo pipefail
if [ $# -lt 1 ]; then echo "usage: show FILE [START:END] [HL[:HL] ...]" >&2; exit 2; fi
file=$1; shift
args=(--theme=Review --style=numbers --paging=never --color=always)
if [ $# -ge 1 ]; then args+=(--line-range "$1"); shift; fi
for h in "$@"; do args+=(--highlight-line "$h"); done
exec batcat "${args[@]}" "$file"
