#!/usr/bin/env python3
"""
Voice toggle daemon for Claude Code.

GNOME shortcut (Ctrl+Space) sends SIGUSR1 to this daemon.
Daemon toggles a virtual Ctrl+K hold/release via uinput.
Claude Code keybinding maps Ctrl+K to voice:pushToTalk.

Press Ctrl+Space once  → Ctrl+K held → recording starts
Press Ctrl+Space again → Ctrl+K released → recording stops
"""

import signal
import sys
import threading
import time
import evdev
from evdev import UInput, ecodes

# Ignore signals arriving within this window of the last accepted toggle.
# GNOME key-repeat fires the shortcut every ~30ms while Ctrl+Space is held,
# which without debouncing leaves parity (and virtual Ctrl+K) unpredictable.
DEBOUNCE_SECONDS = 0.30

# Full keyboard capabilities so Wayland compositor accepts the device
CAPABILITIES = {
    ecodes.EV_KEY: list(range(ecodes.KEY_ESC, ecodes.KEY_COMPOSE + 1)),
}

recording = False
toggle_event = threading.Event()
ui = None


def on_signal(signum, frame):
    """Signal handler — just sets the event flag (async-signal-safe)."""
    toggle_event.set()


def shutdown(signum, frame):
    """Clean shutdown — release keys if held."""
    global recording
    if recording and ui:
        ui.write(ecodes.EV_KEY, ecodes.KEY_K, 0)
        ui.syn()
        ui.write(ecodes.EV_KEY, ecodes.KEY_LEFTCTRL, 0)
        ui.syn()
        recording = False
        print("voice-toggle: released on shutdown", flush=True)
    if ui:
        ui.close()
    sys.exit(0)


if __name__ == "__main__":
    ui = UInput(CAPABILITIES, name="voice-toggle-keyboard")
    print("voice-toggle: started, waiting for SIGUSR1", flush=True)

    signal.signal(signal.SIGUSR1, on_signal)
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    last_toggle = 0.0
    while True:
        toggle_event.wait()
        toggle_event.clear()

        now = time.monotonic()
        if now - last_toggle < DEBOUNCE_SECONDS:
            continue
        last_toggle = now

        if not recording:
            # Start: hold Ctrl+K
            ui.write(ecodes.EV_KEY, ecodes.KEY_LEFTCTRL, 1)
            ui.syn()
            ui.write(ecodes.EV_KEY, ecodes.KEY_K, 1)
            ui.syn()
            recording = True
            print("voice-toggle: ON", flush=True)
        else:
            # Stop: release Ctrl+K
            ui.write(ecodes.EV_KEY, ecodes.KEY_K, 0)
            ui.syn()
            ui.write(ecodes.EV_KEY, ecodes.KEY_LEFTCTRL, 0)
            ui.syn()
            recording = False
            print("voice-toggle: OFF", flush=True)
